import java.util.Scanner;

public class ParkingLotManagement {
    static String[] slots = new String[5];

    static Scanner sc = new Scanner(System.in);

    public static void main(String[] args) {
        int choice;

        do {
            System.out.println("\n--- PARKING LOT MANAGEMENT ---");
            System.out.println("1. Park Vehicle");
            System.out.println("2. Remove Vehicle");
            System.out.println("3. Display Parking Slots");
            System.out.println("4. Exit");
            System.out.print("Enter your choice: ");

            choice = sc.nextInt();
            sc.nextLine();

            switch (choice) {
                case 1:
                    parkVehicle();
                    break;

                case 2:
                    removeVehicle();
                    break;

                case 3:
                    displaySlots();
                    break;

                case 4:
                    System.out.println("Thank you!");
                    break;

                default:
                    System.out.println("Invalid choice!");
            }

        } while (choice != 4);
    }

    static void parkVehicle() {
        System.out.print("Enter vehicle number: ");
        String vehicle = sc.nextLine();

        for (String v : slots) {
            if (vehicle.equalsIgnoreCase(v)) {
                System.out.println("Vehicle already parked!");
                return;
            }
        }

        for (int i = 0; i < slots.length; i++) {
            if (slots[i] == null) {
                slots[i] = vehicle;
                System.out.println("Vehicle parked in slot " + (i + 1));
                return;
            }
        }

        System.out.println("Parking lot is full!");
    }

    static void removeVehicle() {
        System.out.print("Enter vehicle number to remove: ");
        String vehicle = sc.nextLine();

        for (int i = 0; i < slots.length; i++) {
            if (vehicle.equalsIgnoreCase(slots[i])) {
                slots[i] = null;
                System.out.println("Vehicle removed successfully!");
                System.out.println("Parking fee: Rs. 50");
                return;
            }
        }

        System.out.println("Vehicle not found!");
    }

    static void displaySlots() {
        System.out.println("\n--- PARKING SLOT STATUS ---");

        for (int i = 0; i < slots.length; i++) {
            if (slots[i] == null) {
                System.out.println("Slot " + (i + 1) + ": Available");
            } else {
                System.out.println(
                    "Slot " + (i + 1) + ": " + slots[i]
                );
            }
        }
    }
}
